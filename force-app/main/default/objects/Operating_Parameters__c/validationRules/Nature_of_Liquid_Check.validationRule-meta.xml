<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Nature_of_Liquid_Check</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Nature_of_Liquid__c, &apos;Other&apos;) &amp;&amp; ISBLANK( Please_specify_Nature_of_Liquid__c )</errorConditionFormula>
    <errorDisplayField>Please_specify_Nature_of_Liquid__c</errorDisplayField>
    <errorMessage>This field is mandatory if &quot;Other&quot; is selected in Nature of Liquid</errorMessage>
</ValidationRule>
