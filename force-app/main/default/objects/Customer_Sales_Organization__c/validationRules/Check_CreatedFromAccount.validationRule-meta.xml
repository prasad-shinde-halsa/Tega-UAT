<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_CreatedFromAccount</fullName>
    <active>true</active>
    <errorConditionFormula>AND( $Profile.Name != &apos;System Administrator&apos; ,IF( CreatedFromAccount__c , false, true))</errorConditionFormula>
    <errorMessage>Cannot create new Customer Branch Assignment from Opportunity. Please create from Customer Record only</errorMessage>
</ValidationRule>
