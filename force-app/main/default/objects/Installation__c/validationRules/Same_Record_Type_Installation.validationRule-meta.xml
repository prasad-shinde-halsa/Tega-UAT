<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Same_Record_Type_Installation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK( Equipment_Installed_At__c )), Equipment_Installed_At__r.RecordType.Name &lt;&gt; RecordType.Name)</errorConditionFormula>
    <errorDisplayField>Equipment_Installed_At__c</errorDisplayField>
    <errorMessage>Record type of Installation and Customer Equipment should be same</errorMessage>
</ValidationRule>
