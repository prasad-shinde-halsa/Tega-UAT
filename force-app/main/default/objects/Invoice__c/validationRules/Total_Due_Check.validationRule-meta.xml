<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_Due_Check</fullName>
    <active>true</active>
    <errorConditionFormula>IF( Total_Due__c &gt; 100.00, true, false)</errorConditionFormula>
    <errorDisplayField>Total_Due__c</errorDisplayField>
    <errorMessage>Value cannot be more than 100.00</errorMessage>
</ValidationRule>
