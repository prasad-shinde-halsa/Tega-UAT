<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Customer_Name_With_Code__c</fullName>
    <description>Customer (the Offer&apos;s Opportunity Account) name with its SAP customer code, e.g. TATA STEEL LIMITED (CT0004). Used in email template headers.</description>
    <externalId>false</externalId>
    <formula>IF( ISBLANK( SF_Offer__r.Opportunity.Account.Customer_Code__c ),
    SF_Offer__r.Opportunity.Account.Name,
    SF_Offer__r.Opportunity.Account.Name &amp; &quot; (&quot; &amp; SF_Offer__r.Opportunity.Account.Customer_Code__c &amp; &quot;)&quot; )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Customer Name With Code</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
