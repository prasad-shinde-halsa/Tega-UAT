<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Action_For_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c ,&apos;Submit&apos;),ISPICKVAL(Category__c ,&apos;ASO&apos;), OR(ISBLANK(TEXT(Action_For__c)),ISBLANK(TEXT(Exp_Date_of_PO__c))))</errorConditionFormula>
    <errorMessage>Please fill Action for &amp; Exp date of PO fields</errorMessage>
</ValidationRule>
