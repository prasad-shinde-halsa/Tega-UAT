<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrict_Users_Without_Branch</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT(ISNEW()),
ISBLANK(Customer_Branch_Assignment__c),
ISCHANGED(Status__c),
ISPICKVAL(Status__c,&apos;Submitted&apos;)
)</errorConditionFormula>
    <errorMessage>You cannot submit the record without Customer Branch Assignment</errorMessage>
</ValidationRule>
