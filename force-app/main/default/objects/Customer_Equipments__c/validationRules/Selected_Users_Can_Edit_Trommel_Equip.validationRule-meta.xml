<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Selected_Users_Can_Edit_Trommel_Equip</fullName>
    <active>true</active>
    <errorConditionFormula>RecordType.DeveloperName = &quot;Trommel&quot; &amp;&amp;
NOT ( $Permission.Trommel_PMG_Custom_Permission ) &amp;&amp; $Profile.Name &lt;&gt; &quot;System Administrator&quot; &amp;&amp; $Profile.Name &lt;&gt; &quot;Sales&quot; &amp;&amp; $Profile.Name &lt;&gt; &quot;Regional Manager&quot;</errorConditionFormula>
    <errorMessage>Only Trommel Users can edit Trommel Equipments</errorMessage>
</ValidationRule>
