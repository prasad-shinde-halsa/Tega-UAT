<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Selected_Users_Can_Edit_Screen_Equipment</fullName>
    <active>true</active>
    <errorConditionFormula>RecordType.DeveloperName = &quot;Screen&quot; &amp;&amp;
NOT ( $Permission.Screen_PMG_Custom_Permission ) &amp;&amp; $Profile.Name &lt;&gt; &quot;System Administrator&quot; &amp;&amp; $Profile.Name &lt;&gt; &quot;Sales&quot; &amp;&amp; $Profile.Name &lt;&gt; &quot;Regional Manager&quot;</errorConditionFormula>
    <errorMessage>Only Screen Users can edit Screen Equipments</errorMessage>
</ValidationRule>
