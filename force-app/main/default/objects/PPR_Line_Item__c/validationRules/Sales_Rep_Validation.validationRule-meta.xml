<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sales_Rep_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISPICKVAL(Status__c,&apos;New&apos;)),
    NOT(ISPICKVAL(Status__c,&apos;Rejected&apos;)), 
    IF($Profile.Name == &apos;Sales&apos;,true,false), 
    NOT($Permission.SBO_Custom_Permission)  
)</errorConditionFormula>
    <errorMessage>Sales Rep cannot edit</errorMessage>
</ValidationRule>
