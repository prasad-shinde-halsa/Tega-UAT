<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Any_one_field_should_be_there</fullName>
    <active>true</active>
    <errorConditionFormula>if(OR(NOT(ISBLANK(Part_List__c)),NOT(ISBLANK(Sales_Orders__c)) ), false, true)</errorConditionFormula>
