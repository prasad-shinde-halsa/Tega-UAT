<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_Edits_Allowed_on_Invalid</fullName>
    <active>true</active>
    <errorConditionFormula>OR(ISPICKVAL( PRIORVALUE(Status__c) , &apos;Invalid&apos;),ISPICKVAL( PRIORVALUE(Status__c) , &apos;Closed&apos;))</errorConditionFormula>
    <errorMessage>Cannot modify when status in Closed or Invalid</errorMessage>
</ValidationRule>
