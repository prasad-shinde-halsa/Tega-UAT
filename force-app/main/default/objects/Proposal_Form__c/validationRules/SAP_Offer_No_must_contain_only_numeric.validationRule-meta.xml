<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SAP_Offer_No_must_contain_only_numeric</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(SAP_Offer_Number__c, &quot;^[0-9]*$&quot;))</errorConditionFormula>
    <errorDisplayField>SAP_Offer_Number__c</errorDisplayField>
    <errorMessage>SAP Offer No must contain only numeric characters.</errorMessage>
</ValidationRule>
