<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Offer_Type__c</field>
        <field>Discount_Value__c</field>
        <field>RecordType__c</field>
        <field>Total_Price_INR__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Regional_Sales_Head__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Approval if Greater Than 1%</label>
        <name>Approval_if_Greater_Than_1</name>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND ((2 AND 5) OR (6 AND 8)) AND 3 AND 4 AND 7</booleanFilter>
        <criteriaItems>
            <field>Quote.Approval_Status__c</field>
            <operation>equals</operation>
            <value>Submitted</value>
        </criteriaItems>
        <criteriaItems>
            <field>Quote.Total_Price_INR__c</field>
            <operation>lessOrEqual</operation>
            <value>5000000</value>
        </criteriaItems>
        <criteriaItems>
            <field>Quote.Discount_Value__c</field>
            <operation>greaterThan</operation>
            <value>1</value>
        </criteriaItems>
        <criteriaItems>
            <field>Quote.Discount_Value__c</field>
            <operation>lessOrEqual</operation>
            <value>5</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.RecordType</field>
            <operation>equals</operation>
            <value>Mill</value>
        </criteriaItems>
        <criteriaItems>
            <field>Quote.Total_Price_INR__c</field>
            <operation>lessOrEqual</operation>
            <value>1000000</value>
        </criteriaItems>
        <criteriaItems>
            <field>Quote.Status</field>
            <operation>equals</operation>
            <value>Finalized</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.RecordType</field>
            <operation>notEqual</operation>
            <value>Mill</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Price_Approved7</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Status_Approved7</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Price_Rejected7</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Status_Rejected7</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Pending_Approval1</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Approval if Greater Than 1%</label>
    <processOrder>2</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
