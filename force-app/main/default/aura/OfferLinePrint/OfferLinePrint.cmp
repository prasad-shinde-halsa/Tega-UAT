<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes" controller="OfferLinePrintController" access="global">

    <aura:attribute name="isLoading"     type="Boolean" default="false" />
    <aura:attribute name="quoteData"     type="Object" />
    <aura:attribute name="lineItems"     type="List"    default="[]" />
    <aura:attribute name="headers"       type="List"    default="[]" />
    <aura:attribute name="totalBTP"      type="String"  default="0.00" />
    <aura:attribute name="totalSales"    type="String"  default="0.00" />
    <aura:attribute name="totalSalesPct" type="String"  default="0.00" />
    <aura:attribute name="showModal"     type="Boolean" default="false" />
    <aura:attribute name="logoUrl"       type="String"  default="" />

    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

    <aura:html tag="style">
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap');

        :root {
            --blue-700:#1d4ed8; --blue-600:#2563eb; --blue-500:#3b82f6;
            --blue-100:#dbeafe; --blue-50:#eff6ff;
            --s900:#0f172a; --s800:#1e293b; --s700:#334155;
            --s600:#475569; --s500:#64748b; --s400:#94a3b8;
            --s300:#cbd5e1; --s200:#e2e8f0; --s100:#f1f5f9;
            --s50:#f8fafc; --wht:#ffffff;
            --grn-700:#15803d; --grn-600:#16a34a; --grn-100:#dcfce7;
            --vio-700:#6d28d9; --vio-100:#ede9fe;
            --r-sm:6px; --r-md:10px; --r-lg:14px; --r-xl:18px;
            --sh-sm:0 1px 4px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.05);
            --sh-md:0 4px 16px rgba(0,0,0,.10),0 2px 6px rgba(0,0,0,.07);
            --sh-lg:0 12px 40px rgba(0,0,0,.15),0 4px 12px rgba(0,0,0,.08);
            --ease:cubic-bezier(.4,0,.2,1); --d:.18s;
        }

        .olp-wrap, .olp-wrap * {
            box-sizing:border-box;
            font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
        }

        /* ── TRIGGER BUTTON ── */
        .olp-trigger {
            display:inline-flex; align-items:center; gap:8px;
            height:38px; padding:0 20px;
            background:var(--s900); color:var(--wht);
            border:none; border-radius:var(--r-sm);
            font-size:13.5px; font-weight:600; cursor:pointer;
            box-shadow:0 2px 8px rgba(0,0,0,.25);
            transition:all var(--d) var(--ease);
        }
        .olp-trigger:hover { background:var(--s800); transform:translateY(-1px); }

        /* ── MODAL OVERLAY ── */
        .olp-overlay {
            position:fixed; inset:0;
            background:rgba(15,23,42,.6);
            display:flex; align-items:center; justify-content:center;
            z-index:9999; backdrop-filter:blur(4px);
        }
        .olp-modal {
            background:var(--wht); border-radius:var(--r-xl);
            width:98vw; max-width:1200px; max-height:95vh;
            display:flex; flex-direction:column;
            box-shadow:var(--sh-lg); overflow:hidden;
            animation:mIn .25s cubic-bezier(.34,1.56,.64,1);
        }
        @keyframes mIn { from{opacity:0;transform:translateY(20px) scale(.96)} to{opacity:1;transform:none} }

        /* Toolbar */
        .olp-toolbar {
            background:linear-gradient(135deg,var(--s800),var(--s900));
            padding:14px 24px;
            display:flex; align-items:center; justify-content:space-between;
            border-bottom:3px solid var(--blue-600); flex-shrink:0;
        }
        .olp-toolbar-l { display:flex; align-items:center; gap:10px; }
        .olp-tb-bar { width:4px; height:28px; background:var(--blue-600); border-radius:2px; }
        .olp-tb-title { font-size:15px; font-weight:700; color:var(--wht); margin:0; }
        .olp-tb-sub   { font-size:11.5px; color:var(--s400); }
        .olp-toolbar-r { display:flex; align-items:center; gap:10px; }

        .tb-btn {
            display:inline-flex; align-items:center; gap:6px;
            height:36px; padding:0 18px; border-radius:var(--r-sm);
            font-size:13px; font-weight:600; cursor:pointer; border:none;
            transition:all var(--d) var(--ease);
        }
        .tb-btn-print {
            background:var(--blue-600); color:var(--wht);
            box-shadow:0 2px 8px rgba(37,99,235,.35);
        }
        .tb-btn-print:hover { background:var(--blue-700); transform:translateY(-1px); }
        .tb-btn-close {
            background:rgba(255,255,255,.1); color:var(--s300);
            border:1px solid rgba(255,255,255,.15);
        }
        .tb-btn-close:hover { background:rgba(255,255,255,.18); color:var(--wht); }

        /* Scrollable body */
        .olp-body { overflow-y:auto; padding:24px; flex:1; background:var(--s100); }

        /* ── PRINT DOCUMENT ── */
        .olp-doc {
            background:var(--wht); border-radius:var(--r-lg);
            border:1px solid var(--s200); box-shadow:var(--sh-sm);
            overflow:hidden;
        }

        /* Doc Header */
        .olp-doc-hdr {
            background:linear-gradient(135deg,var(--s900) 0%,var(--s800) 100%);
            padding:28px 32px 24px; position:relative; overflow:hidden;
        }
        .olp-doc-hdr::after {
            content:''; position:absolute; right:-50px; top:-50px;
            width:200px; height:200px;
            background:rgba(37,99,235,.12); border-radius:50%;
        }
        .olp-doc-hdr::before {
            content:''; position:absolute; right:80px; bottom:-30px;
            width:120px; height:120px;
            background:rgba(37,99,235,.08); border-radius:50%;
        }
        .olp-hdr-top {
            display:flex; justify-content:space-between; align-items:flex-start;
            position:relative; z-index:1;
        }

        /* Logo + company */
        .olp-logo-block { display:flex; align-items:center; gap:16px; }
        .olp-logo-img {
            width:68px; height:68px; border-radius:10px;
            object-fit:contain; background:var(--wht);
            padding:6px; border:2px solid rgba(255,255,255,.25);
            flex-shrink:0;
        }
        .olp-logo-placeholder {
            width:68px; height:68px; border-radius:10px;
            background:rgba(255,255,255,.08);
            border:2px dashed rgba(255,255,255,.3);
            display:flex; align-items:center; justify-content:center;
            font-size:28px; flex-shrink:0; color:rgba(255,255,255,.4);
        }
        .olp-badge-type {
            display:inline-block; background:var(--blue-600);
            color:var(--wht); font-size:10px; font-weight:700;
            letter-spacing:1px; text-transform:uppercase;
            padding:3px 10px; border-radius:20px; margin-bottom:6px;
        }
        .olp-company-name { font-size:22px; font-weight:700; color:var(--wht); margin:0 0 3px; letter-spacing:-.3px; }
        .olp-company-sub  { font-size:12.5px; color:var(--s400); }

        /* Offer ref */
        .olp-ref { text-align:right; }
        .olp-ref-lbl  { font-size:10.5px; color:var(--s500); font-weight:600; text-transform:uppercase; letter-spacing:.6px; }
        .olp-ref-num  { font-size:22px; font-weight:700; color:var(--wht); letter-spacing:-.3px; }
        .olp-ref-date { font-size:12px; color:var(--s400); margin-top:2px; }

        /* Meta strip */
        .olp-meta { display:grid; grid-template-columns:repeat(5,1fr); border-top:1px solid var(--s200); }
        .olp-meta-cell { padding:14px 18px; border-right:1px solid var(--s200); }
        .olp-meta-cell:last-child { border-right:none; }
        .olp-meta-lbl { font-size:10px; font-weight:600; color:var(--s400); text-transform:uppercase; letter-spacing:.6px; margin-bottom:3px; }
        .olp-meta-val { font-size:13.5px; font-weight:600; color:var(--s800); }

        /* Summary cards */
        .olp-summary {
            display:grid; grid-template-columns:repeat(3,1fr);
            gap:14px; padding:18px 20px;
            background:var(--s50); border-bottom:1px solid var(--s200);
        }
        .olp-sum-card {
            background:var(--wht); border-radius:var(--r-md);
            border:1px solid var(--s200);
            padding:14px 18px; display:flex; align-items:center; gap:14px;
        }
        .olp-sum-ico { width:42px; height:42px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0; }
        .olp-sum-ico.btp   { background:var(--blue-100); }
        .olp-sum-ico.sales { background:var(--grn-100); }
        .olp-sum-ico.pct   { background:var(--vio-100); }
        .olp-sum-lbl { font-size:10.5px; font-weight:600; color:var(--s400); text-transform:uppercase; letter-spacing:.5px; margin-bottom:3px; }
        .olp-sum-val { font-size:20px; font-weight:700; letter-spacing:-.5px; }
        .olp-sum-val.btp   { color:var(--s800); }
        .olp-sum-val.sales { color:var(--grn-600); }
        .olp-sum-val.pct   { color:var(--vio-700); }

        /* Table */
        .olp-tbl-title {
            padding:14px 20px 8px;
            font-size:11px; font-weight:600; color:var(--s500);
            text-transform:uppercase; letter-spacing:.7px;
            border-bottom:2px solid var(--s100);
        }
        .olp-tbl { width:100%; border-collapse:collapse; font-size:12.5px; }
        .olp-tbl thead tr { background:linear-gradient(180deg,var(--s800) 0%,var(--s900) 100%); }
        .olp-tbl thead th {
            padding:11px 13px; font-size:10.5px; font-weight:600;
            color:var(--s400); text-transform:uppercase; letter-spacing:.7px;
            white-space:nowrap; border-right:1px solid rgba(255,255,255,.05);
            text-align:left;
        }
        .olp-tbl thead th:last-child { border-right:none; }
        .olp-tbl thead th.thc { text-align:center; }
        .olp-tbl thead th.thr { text-align:right; }

        .olp-tbl tbody tr { border-bottom:1px solid var(--s200); }
        .olp-tbl tbody tr:last-child { border-bottom:none; }
        .olp-tbl tbody tr:nth-child(even) { background:var(--s50); }
        .olp-tbl tbody td {
            padding:9px 13px; color:var(--s800);
            vertical-align:middle; border-right:1px solid var(--s200);
        }
        .olp-tbl tbody td:last-child { border-right:none; }

        .td-sno   { font-size:11px; color:var(--s400); font-weight:600; text-align:center; width:36px; }
        .td-pname { font-weight:700; font-size:13px; color:var(--s900); }
        .td-psub  { font-size:11px; color:var(--s500); margin-top:2px; }
        .td-qty   { text-align:center; font-weight:600; color:var(--s600); font-size:13px; }
        .td-tqty  { text-align:center; font-weight:700; font-size:13px; color:var(--blue-600); }
        .td-price { text-align:right; font-weight:600; font-size:13px; white-space:nowrap; }
        .td-price.btp   { color:var(--s800); }
        .td-price.sales { color:var(--grn-600); }
        .td-price.last  { color:var(--s500); font-size:12px; }
        .td-muted { text-align:right; font-size:12px; color:var(--s500); font-weight:500; }
        .td-date  { font-size:12px; color:var(--s400); white-space:nowrap; }

        .badge-fx {
            display:inline-flex; align-items:center; gap:3px;
            background:var(--vio-100); color:var(--vio-700);
            border:1px solid #c4b5fd; border-radius:20px;
            padding:2px 8px; font-size:10px; font-weight:700; white-space:nowrap;
        }

        /* Tfoot */
        .olp-tbl tfoot tr { background:linear-gradient(135deg,var(--s800),var(--s900)); }
        .olp-tbl tfoot td {
            padding:12px 13px; font-size:12.5px; font-weight:700;
            color:var(--wht); border-right:1px solid rgba(255,255,255,.07);
        }
        .olp-tbl tfoot td:last-child { border-right:none; }
        .tft-lbl   { text-align:right; font-size:10.5px; font-weight:600; color:var(--s400) !important; text-transform:uppercase; letter-spacing:.5px; }
        .tft-btp   { text-align:right; color:#93c5fd !important; }
        .tft-sales { text-align:right; color:#86efac !important; }
        .tft-pct   { text-align:right; color:#c4b5fd !important; }

        /* Doc footer */
        .olp-doc-foot {
            padding:14px 20px; background:var(--s50);
            border-top:1px solid var(--s200);
            display:flex; align-items:center; justify-content:space-between;
        }
        .olp-foot-note  { font-size:11.5px; color:var(--s400); }
        .olp-foot-stamp { font-size:11px; color:var(--s400); text-align:right; }

        /* Loader */
        .olp-loader { display:flex; align-items:center; justify-content:center; padding:64px; gap:14px; }
        .olp-spin   { width:36px; height:36px; border:3px solid var(--s200); border-top:3px solid var(--blue-600); border-radius:50%; animation:sp .7s linear infinite; }
        @keyframes sp { to{transform:rotate(360deg)} }
        .olp-loader p { font-size:14px; color:var(--s500); font-weight:500; margin:0; }

        .slds-hide { display:none !important; }

        /* ── PRINT STYLES ── */
        @media print {
            body > * { display:none !important; }
            .olp-print-zone {
                display:block !important; position:fixed !important;
                inset:0 !important; padding:10mm !important;
                background:white !important;
            }
            .olp-toolbar { display:none !important; }
            .olp-doc { box-shadow:none !important; border:none !important; border-radius:0 !important; }
            .olp-tbl thead tr,
            .olp-tbl tfoot tr,
            .olp-doc-hdr {
                -webkit-print-color-adjust:exact;
                print-color-adjust:exact;
            }
            .olp-tbl thead tr { background:#1e293b !important; }
            .olp-tbl tfoot tr { background:#1e293b !important; }
            .olp-doc-hdr      { background:#0f172a !important; }
            .olp-tbl tbody tr:nth-child(even) {
                background:#f8fafc !important;
                -webkit-print-color-adjust:exact;
                print-color-adjust:exact;
            }
            @page { margin:10mm; size:A4 landscape; }
        }
    </aura:html>

    <div class="olp-wrap">

        <!-- TRIGGER BUTTON — uses lightning:icon, no raw SVG -->
        <lightning:button
            label="Print Offer Lines"
            iconName="utility:print"
            variant="brand"
            onclick="{!c.openModal}" />

        <!-- MODAL -->
        <aura:if isTrue="{!v.showModal}">
            <div class="olp-overlay">
                <div class="olp-modal">

                    <!-- Toolbar -->
                    <div class="olp-toolbar">
                        <div class="olp-toolbar-l">
                            <div class="olp-tb-bar"></div>
                            <div>
                                <div class="olp-tb-title">Offer Line Items — Print Preview</div>
                                <div class="olp-tb-sub">Review carefully before printing or saving as PDF</div>
                            </div>
                        </div>
                        <div class="olp-toolbar-r">
                            <lightning:button
                                label="Print / Save PDF"
                                iconName="utility:print"
                                variant="brand"
                                onclick="{!c.printDoc}" />
                            <lightning:button
                                label="Close"
                                iconName="utility:close"
                                variant="neutral"
                                onclick="{!c.closeModal}" />
                        </div>
                    </div>

                    <!-- Scrollable body -->
                    <div class="olp-body">

                        <!-- LOADER -->
                        <aura:if isTrue="{!v.isLoading}">
                            <div class="olp-loader">
                                <div class="olp-spin"></div>
                                <p>Loading offer line items…</p>
                            </div>
                        </aura:if>

                        <!-- PRINT DOCUMENT -->
                        <aura:if isTrue="{!not(v.isLoading)}">
                            <div class="olp-print-zone olp-doc">

                                <!-- DOC HEADER -->
                                <div class="olp-doc-hdr">
                                    <div class="olp-hdr-top">

                                        <!-- Logo + Company -->
                                        <div class="olp-logo-block">
                                            <aura:if isTrue="{!not(empty(v.logoUrl))}">
                                                <img src="{!v.logoUrl}"
                                                     class="olp-logo-img"
                                                     alt="Company Logo" />
                                                <aura:set attribute="else">
                                                    <div class="olp-logo-placeholder">🏢</div>
                                                </aura:set>
                                            </aura:if>
                                            <div>
                                                <div class="olp-badge-type">Offer Quotation</div>
                                                <div class="olp-company-name">
                                                    <aura:if isTrue="{!v.quoteData}">{!v.quoteData.AccountName}</aura:if>
                                                </div>
                                                <div class="olp-company-sub">
                                                    <aura:if isTrue="{!v.quoteData}">
                                                        Sales Org: {!v.quoteData.SalesOrg} &nbsp;|&nbsp; Branch: {!v.quoteData.Branch}
                                                    </aura:if>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Offer Ref -->
                                        <div class="olp-ref">
                                            <div class="olp-ref-lbl">Offer Number</div>
                                            <div class="olp-ref-num">
                                                <aura:if isTrue="{!v.quoteData}">{!v.quoteData.Name}</aura:if>
                                            </div>
                                            <div class="olp-ref-date">
                                                Printed: <aura:if isTrue="{!v.quoteData}">{!v.quoteData.PrintDate}</aura:if>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <!-- META STRIP -->
                                <div class="olp-meta">
                                    <div class="olp-meta-cell">
                                        <div class="olp-meta-lbl">Currency</div>
                                        <div class="olp-meta-val">
                                            <aura:if isTrue="{!v.quoteData}">{!v.quoteData.CurrencyIsoCode}</aura:if>
                                        </div>
                                    </div>
                                    <div class="olp-meta-cell">
                                        <div class="olp-meta-lbl">Part List</div>
                                        <div class="olp-meta-val">
                                            <aura:if isTrue="{!v.quoteData}">{!v.quoteData.PartList}</aura:if>
                                        </div>
                                    </div>
                                    <div class="olp-meta-cell">
                                        <div class="olp-meta-lbl">BTP Type</div>
                                        <div class="olp-meta-val">
                                            <aura:if isTrue="{!v.quoteData}">{!v.quoteData.BTPType}</aura:if>
                                        </div>
                                    </div>
                                    <div class="olp-meta-cell">
                                        <div class="olp-meta-lbl">Status</div>
                                        <div class="olp-meta-val">
                                            <aura:if isTrue="{!v.quoteData}">{!v.quoteData.Status}</aura:if>
                                        </div>
                                    </div>
                                    <div class="olp-meta-cell">
                                        <div class="olp-meta-lbl">Total Line Items</div>
                                        <div class="olp-meta-val">{!v.lineItems.length}</div>
                                    </div>
                                </div>

                                <!-- SUMMARY CARDS -->
                                <div class="olp-summary">
                                    <div class="olp-sum-card">
                                        <div class="olp-sum-ico btp">💰</div>
                                        <div>
                                            <div class="olp-sum-lbl">Total BTP Price</div>
                                            <div class="olp-sum-val btp">{!v.totalBTP}</div>
                                        </div>
                                    </div>
                                    <div class="olp-sum-card">
                                        <div class="olp-sum-ico sales">📈</div>
                                        <div>
                                            <div class="olp-sum-lbl">Total Sales Price</div>
                                            <div class="olp-sum-val sales">{!v.totalSales}</div>
                                        </div>
                                    </div>
                                    <div class="olp-sum-card">
                                        <div class="olp-sum-ico pct">📊</div>
                                        <div>
                                            <div class="olp-sum-lbl">Overall Sales %</div>
                                            <div class="olp-sum-val pct">{!v.totalSalesPct}%</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- LINE ITEMS TABLE -->
                                <div class="olp-tbl-title">Product Line Items</div>
                                <table class="olp-tbl">
                                    <thead>
                                        <tr>
                                            <th class="thc" style="width:40px;">#</th>
                                            <th>Product Name</th>
                                            <th>Description</th>
                                            <aura:iteration items="{!v.headers}" var="hdr">
                                                <th class="thc">{!hdr}</th>
                                            </aura:iteration>
                                            <th class="thc">Total Qty</th>
                                            <th class="thc">Cust Qty</th>
                                            <th class="thr">BTP Price</th>
                                            <th class="thr">Margin %</th>
                                            <th class="thr">My Sales Price</th>
                                            <th class="thr">Last Sale Price</th>
                                            <th>Last SO Date</th>
                                            <th class="thc">Fixed</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <aura:iteration items="{!v.lineItems}" var="item" indexVar="idx">
                                            <tr>
                                                <td class="td-sno">{! idx + 1 }</td>
                                                <td>
                                                    <div class="td-pname">{!item.ProductName}</div>
                                                    <div class="td-psub">{!item.ProductCode}</div>
                                                </td>
                                                <td style="max-width:160px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                                    <span class="td-psub">{!item.Description}</span>
                                                </td>
                                                <aura:iteration items="{!item.L2Quantities}" var="l2q">
                                                    <td class="td-qty">{!l2q}</td>
                                                </aura:iteration>
                                                <td class="td-tqty">{!item.TotalQty}</td>
                                                <td class="td-qty">{!item.CustomQty}</td>
                                                <td class="td-price btp">{!item.BTPPrice}</td>
                                                <td class="td-muted">{!item.Margin}%</td>
                                                <td class="td-price sales">{!item.SalesPrice}</td>
                                                <td class="td-price last">{!item.LastSalePrice}</td>
                                                <td class="td-date">{!item.LastSODate}</td>
                                                <td style="text-align:center; min-width:70px;">
                                                    <aura:if isTrue="{!item.IsFixed}">
                                                        <span class="badge-fx">&#9733; Fixed</span>
                                                    </aura:if>
                                                </td>
                                            </tr>
                                        </aura:iteration>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <aura:iteration items="{!v.headers}" var="hdr">
                                                <td></td>
                                            </aura:iteration>
                                            <td></td>
                                            <td class="tft-lbl">TOTALS</td>
                                            <td class="tft-btp">{!v.totalBTP}</td>
                                            <td></td>
                                            <td class="tft-sales">{!v.totalSales}</td>
                                            <td></td>
                                            <td class="tft-pct">{!v.totalSalesPct}%</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>

                                <!-- DOC FOOTER -->
                                <div class="olp-doc-foot">
                                    <div class="olp-foot-note">
                                        System-generated document. All prices in
                                        <aura:if isTrue="{!v.quoteData}">{!v.quoteData.CurrencyIsoCode}</aura:if>.
                                        Subject to management approval.
                                    </div>
                                    <div class="olp-foot-stamp">
                                        <div>Generated via Salesforce CRM</div>
                                        <div>
                                            <aura:if isTrue="{!v.quoteData}">{!v.quoteData.PrintDate}</aura:if>
                                        </div>
                                    </div>
                                </div>

                            </div><!-- /.olp-doc -->
                        </aura:if>

                    </div><!-- /.olp-body -->
                </div><!-- /.olp-modal -->
            </div><!-- /.olp-overlay -->
        </aura:if>

    </div><!-- /.olp-wrap -->

</aura:component>