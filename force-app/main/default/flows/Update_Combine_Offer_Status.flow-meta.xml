    <decisions>
        <name>Lost_PartialLost</name>
        <label>Lost/PartialLost</label>
        <locationX>578</locationX>
        <locationY>1367</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>LostOffer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TotalChildOffers</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Lost</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lost_On_Combine_Offer</targetReference>
            </connector>
            <label>LostOffer</label>
        </rules>
        <rules>
            <name>PartialLostOffer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Lost</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>TotalChildOffers</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Lost</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_PLost_On_Combine_Offer</targetReference>
            </connector>
            <label>PartialLostOffer</label>
        </rules>
        <rules>
            <name>WonOffer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TotalChildOffers</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Won</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Won_On_Combine_Offer</targetReference>
            </connector>
            <label>WonOffer</label>
        </rules>
        <rules>
            <name>PartialWonOffers</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TotalChildOffers</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Won</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Won</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_PWon_On_Combine_Offer</targetReference>
            </connector>
            <label>PartialWonOffers</label>
        </rules>
    </decisions>
