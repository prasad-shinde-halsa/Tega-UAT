    <decisions>
        <name>Combine_Or_Not</name>
        <label>Combine Or Not</label>
        <locationX>974</locationX>
        <locationY>455</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
