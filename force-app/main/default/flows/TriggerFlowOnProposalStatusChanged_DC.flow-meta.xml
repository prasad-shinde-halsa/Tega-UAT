    <decisions>
        <description>Checks whether Status is Closed Or Submitted To Pmg</description>
        <name>IsStatusIsClosedOrSubmittedToPMG</name>
        <label>IsStatusIsClosedOrSubmittedToPMG</label>
        <locationX>714</locationX>
        <locationY>33</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>statusIsClosed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IfStatusIsClosed</targetReference>
            </connector>
            <label>statusIsClosed</label>
        </rules>
        <rules>
            <name>statusIsSubmittedToPMG</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted to PMG</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IfStatusIsSubmittedToPMG</targetReference>
            </connector>
            <label>statusIsSubmittedToPMG</label>
        </rules>
        <rules>
            <name>statusNotEqualToSubmittedToPMGOrClosed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Submitted to PMG</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IfStatusIsNotSubmittedToPMGOrClosed</targetReference>
            </connector>
            <label>statusNotEqualToSubmittedToPMGAndClosed</label>
        </rules>
    </decisions>
    <environments>Default</environments>
