    <description>Added Exchange rates</description>
    <environments>Default</environments>
    <formulas>
        <name>CalculateConvertedOrderValue</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Total_Order__c}/{!Get_Dated_exchange_Rate.ConversionRate}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculateConvertedSalesValue</name>
