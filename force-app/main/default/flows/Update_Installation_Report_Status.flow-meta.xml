        <locationX>632</locationX>
        <locationY>290</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_the_record_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Installation_Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Installation_Record.Count_Installation_LineItems__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_Status_to_Submitted_to_PMG</targetReference>
            </connector>
            <label>Is the record New?</label>
        </rules>
        <rules>
            <name>Is_Record_Submitted_to_PMG</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Installation_Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted to PMG</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Installation_Record.Count_Installation_LineItems__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_Status_to_Closed</targetReference>
            </connector>
            <label>Is Record Submitted to PMG</label>
        </rules>
        <rules>
            <name>No_Line_Item_Associated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Installation_Record.Count_Installation_LineItems__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ShowErrorMsgForNoLineItem</targetReference>
            </connector>
            <label>No Line Item Associated</label>
        </rules>
    </decisions>
