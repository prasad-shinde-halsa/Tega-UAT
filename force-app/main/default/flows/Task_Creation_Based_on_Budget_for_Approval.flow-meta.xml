    <decisions>
        <name>Check_the_Approval_Status</name>
        <label>Check the Approval Status</label>
        <locationX>818</locationX>
        <locationY>948</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Submitted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Profile_Of_Regional_Manager</targetReference>
            </connector>
            <label>Submitted</label>
        </rules>
        <rules>
            <name>X2nd_Level_Approved_with_com</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>2nd Level Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Company__r.Name</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>loop_on_all_BLI</targetReference>
            </connector>
            <label>2nd Level Approved with com</label>
        </rules>
        <rules>
            <name>X2nd_Level_Approved_without_com</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>2nd Level Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Company__r.Name</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>2nd Level Approved without com</label>
        </rules>
        <rules>
            <name>X1st_Level_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>1st Level Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_metadata_for_3rd_level_approver</targetReference>
            </connector>
            <label>1st Level Approved</label>
        </rules>
        <rules>
            <name>X3rd_Level_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>3rd Level Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_metadata_for_4th_level_approver</targetReference>
            </connector>
            <label>3rd Level Approved</label>
        </rules>
    </decisions>
