<apex:page controller="TopExcellPrintController"
           renderAs="pdf"
           contentType="application/pdf#TOP_Report.pdf"
           showHeader="false"
           sidebar="false"
           applyBodyTag="false">

<html>
<head>
    <style type="text/css">
        body {
            font-family: Arial;
            font-size: 10pt;
        }

        .logo img {
            width: 80px;
            
        }

        .header {
            font-size: 12pt;
            font-weight: bold;
        }

        .section {
            margin-top: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td {
            padding: 6px;
            vertical-align: top;
        }

        .right {
            text-align: right;
        }

        .border-table {
            border: 1px solid black;
            margin-top: 20px;
        }

        .border-table th,
        .border-table td {
            border: 1px solid black;
            padding: 6px;
        }

        .table-header {
            background-color: #d9d9d9;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <table>
        <tr class="logo">
            <td colspan="2" style="padding-bottom:10px;">
                <img src="{!URLFOR($Resource.TegaLogo)}"/>
            </td>
        </tr>

        <tr>
            <td class="header">
                Customer : {!customerName}<br/>
                Branch : {!branch}<br/>
                Part List : {!partList}<br/>
                Enquiry No. : {!enquiryNo}<br/>
                Description : {!description}<br/>
                Destination :
            </td>

            <td class="header right">
                Issued : {!issuedDate}<br/>
                SAP Offer Number : <br/>
                Quote No. : {!quoteNo}<br/>
                Validity : {!validity}<br/>
                Currency : {!currency1}<br/>
                Delivery Schedule : {!deliverySchedule}
            </td>
        </tr>
    </table>

    <table class="border-table">
        <tr class="table-header">
            <th>Item</th>
            <th>Description</th>
            <th>Qty</th>
            <th>Price</th>
        </tr>

        <tr>
            <td>1</td>
            <td>Sample Item</td>
            <td>10</td>
            <td>1000</td>
        </tr>
    </table>

</body>
</html>
</apex:page>