<apex:page standardController="Part_List__c" extensions="Ctrl_PartList_Metrix" standardStylesheets="false" applyBodyTag="false" sidebar="false" showHeader="false" renderAs="PDF">
    <head>
        <style>
            @page
            {
            size:portrait;
            @bottom-center {
            content: "Page " counter(page) " of " counter(pages);
            }
            }
            
            /* border for table */
            
            table, th, td {
            border: 1px solid #444;
            border-collapse: collapse;
            word-wrap: break-word;
            }
            
            table[border="0"] td,
            table[border="0"] th {
            border: none;
            word-wrap: break-word;
            }
            
            tr {
            page-break-inside: avoid;
            }
            
            
            
            span.avoid-wrap {
            display: inline-block;
            }
            
            a>span.avoid-wrap {
            display: inline;
            }
            
        </style>
    </head>
    <table align='center'>
        <thead>
            <tr> 
                <th>Part List Number</th>
                <th>Customer Name</th>
                <th>Type and Size</th>
            </tr>
        </thead>
        <tbody>
            <apex:repeat value="{!plList}" var="PLM2" id="plm2">
                <tr>
                    <td><apex:outputText value="{!PLM2.Name}" style="font-family: sans-serif;font-size:10px;"/></td>
                    <td><apex:outputText value="{!PLM2.Customer_Name__c}" style="font-family: sans-serif;font-size:10px;"/></td>
                    <td><apex:outputText value="{!PLM2.Description__c}" style="font-family: sans-serif;font-size:10px;"/></td>
                </tr>
            </apex:repeat>
        </tbody>
    </table><br/><br/>
    <apex:pageBlock >
        <table align='center'>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Item Code</th>
                    <th>Item Description</th>
                    <th>FEH</th>
                    <th>DEH</th>
                    <th>SHL</th>
                    <th>SPR</th>
                    <th>TOT</th>
                </tr>
            </thead>
            <tbody>
                <apex:variable value="{!0}" var="proNum"/>
                <apex:repeat value="{!filterList}" var="PLM" id="plm">
                    <tr>
                        <td>
                            <apex:outputText value="{0}" style="float:right; font-family: sans-serif;font-size:10px;">                
                                <apex:param value="{!proNum}"/> 
                                <apex:variable value="{!proNum+1}" var="proNum"/>
                            </apex:outputText>
                        </td>
                        <td><apex:outputText value="{!PLM.L2ProductName}" style="font-family: sans-serif;font-size:10px;"/></td>
                        <td><apex:outputText value="{!PLM.ItemDescription}" style="font-family: sans-serif;font-size:10px;"/></td>
                        <td><apex:outputText value="{!PLM.fehQuantity}" style="float:right; font-family: sans-serif;font-size:10px;" /></td>
                        <td><apex:outputText value="{!PLM.dehQuantity}" style="float:right; font-family: sans-serif;font-size:10px;"/></td>
                        <td><apex:outputText value="{!PLM.shellQuantity}" style="float:right; font-family: sans-serif;font-size:10px;"/></td>
                        <td><apex:outputText value="{!PLM.spareQuantity}" style="float:right; font-family: sans-serif;font-size:10px;"/></td>
                        <td><apex:outputText value="{!PLM.PLMtotalQuantity}" style="float:right; font-family: sans-serif;font-size:10px;" escape="false"/></td>
                    </tr>
                </apex:repeat>
            </tbody>
        </table>
    </apex:pageBlock>
</apex:page>