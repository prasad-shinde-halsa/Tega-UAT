<apex:page standardController="Quote" extensions="Ctrl_Quote_PartList_Metrix" 
           contentType="application/vnd.ms-excel#PartList_{!Quote.Name}.xls" 
           cache="true" showHeader="false" sidebar="false" 
           standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false">
    
<apex:outputText value="{!'<?xml version=\"1.0\"?>'}" escape="false"/>
<apex:outputText value="{!'<?mso-application progid=\"Excel.Sheet\"?>'}" escape="false"/>

<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
          xmlns:o="urn:schemas-microsoft-com:office:office"
          xmlns:x="urn:schemas-microsoft-com:office:excel"
          xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
          xmlns:html="http://www.w3.org/TR/REC-html40">

    <!-- Define Styles for the Excel File -->
    <Styles>
        <Style ss:ID="HeaderStyle">
            <Font ss:Bold="1" />
            <Interior ss:Color="#DCDCDC" ss:Pattern="Solid" />
            <Alignment ss:Horizontal="Center"/>
        </Style>
        <Style ss:ID="BoldStyle">
            <Font ss:Bold="1" />
        </Style>
        <Style ss:ID="CurrencyStyle">
            <NumberFormat ss:Format="0.00"/>
        </Style>
    </Styles>

    <!-- ========================================== -->
    <!-- SECTION 1: PLM WORKBOOKS                   -->
    <!-- ========================================== -->
    <apex:outputPanel layout="none" rendered="{!PL.Part_List_Type__c == 'PLM'}">
        
        <!-- 1. FULLSET TAB -->
        <Worksheet ss:Name="FullSet">
            <Table>
                <!-- Quote Header Info -->
                <Row><Cell ss:StyleID="BoldStyle"><Data ss:Type="String">Quote Number :</Data></Cell>
                     <Cell><Data ss:Type="String"><apex:outputText value="{!Quote.Name}"/></Data></Cell></Row>
                <Row><Cell ss:StyleID="BoldStyle"><Data ss:Type="String">Partlist Number :</Data></Cell>
                     <Cell><Data ss:Type="String"><apex:outputText value="{!PL.Name}"/></Data></Cell></Row>
                <Row><Cell ss:StyleID="BoldStyle"><Data ss:Type="String">Customer Name :</Data></Cell>
                     <Cell><Data ss:Type="String"><apex:outputText value="{!PL.Customer__c}"/></Data></Cell></Row>
                <Row><Cell ss:StyleID="BoldStyle"><Data ss:Type="String">Type and Size :</Data></Cell>
                     <Cell><Data ss:Type="String"><apex:outputText value="{!PL.Description__c}"/></Data></Cell></Row>
                <Row><Cell/></Row>
                
                <!-- Table Headers -->
                <Row>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Sr.No</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Item Code</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Item Description</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Unit Price</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">FEH Qty</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">FEH Total</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">DEH Qty</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">DEH Total</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">SHELL Qty</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">SHELL Total</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">SPARE Qty</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">SPARE Total</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">TOTAL QTY</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">TOTAL VALUE</Data></Cell>
                </Row>
                
                <!-- Table Data -->
                <apex:variable value="{!1}" var="fsNum"/>
                <apex:repeat value="{!filterList}" var="PLM">
                    <Row>
                        <Cell><Data ss:Type="Number"><apex:outputText value="{!fsNum}"/></Data></Cell>
                        <Cell><Data ss:Type="String"><apex:outputText value="{!PLM.L2ProductName}" escape="true"/></Data></Cell>
                        <Cell><Data ss:Type="String"><apex:outputText value="{!PLM.ItemDescription}" escape="true"/></Data></Cell>
                        <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.unitPrice}"/></Data></Cell>
                        <Cell><Data ss:Type="Number"><apex:outputText value="{!PLM.fehQuantity}"/></Data></Cell>
                        <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.fehTotal}"/></Data></Cell>
                        <Cell><Data ss:Type="Number"><apex:outputText value="{!PLM.dehQuantity}"/></Data></Cell>
                        <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.dehTotal}"/></Data></Cell>
                        <Cell><Data ss:Type="Number"><apex:outputText value="{!PLM.shellQuantity}"/></Data></Cell>
                        <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.shellTotal}"/></Data></Cell>
                        <Cell><Data ss:Type="Number"><apex:outputText value="{!PLM.spareQuantity}"/></Data></Cell>
                        <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.spareTotal}"/></Data></Cell>
                        <Cell><Data ss:Type="Number"><apex:outputText value="{!PLM.PLMtotalQuantity}"/></Data></Cell>
                        <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.PLMtotalValue}"/></Data></Cell>
                    </Row>
                    <apex:variable value="{!fsNum+1}" var="fsNum"/>
                </apex:repeat>
            </Table>
        </Worksheet>

        <!-- 2. FEH TAB -->
        <Worksheet ss:Name="FEH">
            <Table>
                <Row><Cell ss:StyleID="BoldStyle"><Data ss:Type="String">Partlist Number :</Data></Cell>
                     <Cell><Data ss:Type="String"><apex:outputText value="{!PL.Name}"/></Data></Cell></Row>
                <Row><Cell/></Row>
                <Row>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Sr.No</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Item Code</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Item Description</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Unit Price</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">FEH Qty</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">FEH Total</Data></Cell>
                </Row>
                <apex:variable value="{!1}" var="fehNum"/>
                <apex:repeat value="{!filterList}" var="PLM">
                    <Row>
                        <Cell><Data ss:Type="Number"><apex:outputText value="{!fehNum}"/></Data></Cell>
                        <Cell><Data ss:Type="String"><apex:outputText value="{!PLM.L2ProductName}" escape="true"/></Data></Cell>
                        <Cell><Data ss:Type="String"><apex:outputText value="{!PLM.ItemDescription}" escape="true"/></Data></Cell>
                        <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.unitPrice}"/></Data></Cell>
                        <Cell><Data ss:Type="Number"><apex:outputText value="{!PLM.fehQuantity}"/></Data></Cell>
                        <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.fehTotal}"/></Data></Cell>
                    </Row>
                    <apex:variable value="{!fehNum+1}" var="fehNum"/>
                </apex:repeat>
            </Table>
        </Worksheet>

        <!-- 3. DEH TAB -->
        <Worksheet ss:Name="DEH">
            <Table>
                <Row><Cell ss:StyleID="BoldStyle"><Data ss:Type="String">Partlist Number :</Data></Cell>
                     <Cell><Data ss:Type="String"><apex:outputText value="{!PL.Name}"/></Data></Cell></Row>
                <Row><Cell/></Row>
                <Row>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Sr.No</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Item Code</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Item Description</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Unit Price</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">DEH Qty</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">DEH Total</Data></Cell>
                </Row>
                <apex:variable value="{!1}" var="dehNum"/>
                <apex:repeat value="{!filterList}" var="PLM">
                    <Row>
                        <Cell><Data ss:Type="Number"><apex:outputText value="{!dehNum}"/></Data></Cell>
                        <Cell><Data ss:Type="String"><apex:outputText value="{!PLM.L2ProductName}" escape="true"/></Data></Cell>
                        <Cell><Data ss:Type="String"><apex:outputText value="{!PLM.ItemDescription}" escape="true"/></Data></Cell>
                        <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.unitPrice}"/></Data></Cell>
                        <Cell><Data ss:Type="Number"><apex:outputText value="{!PLM.dehQuantity}"/></Data></Cell>
                        <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.dehTotal}"/></Data></Cell>
                    </Row>
                    <apex:variable value="{!dehNum+1}" var="dehNum"/>
                </apex:repeat>
            </Table>
        </Worksheet>

        <!-- 4. SHELL TAB -->
        <Worksheet ss:Name="SHELL">
            <Table>
                <Row><Cell ss:StyleID="BoldStyle"><Data ss:Type="String">Partlist Number :</Data></Cell>
                     <Cell><Data ss:Type="String"><apex:outputText value="{!PL.Name}"/></Data></Cell></Row>
                <Row><Cell/></Row>
                <Row>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Sr.No</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Item Code</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Item Description</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Unit Price</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">SHELL Qty</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">SHELL Total</Data></Cell>
                </Row>
                <apex:variable value="{!1}" var="shNum"/>
                <apex:repeat value="{!filterList}" var="PLM">
                    <Row>
                        <Cell><Data ss:Type="Number"><apex:outputText value="{!shNum}"/></Data></Cell>
                        <Cell><Data ss:Type="String"><apex:outputText value="{!PLM.L2ProductName}" escape="true"/></Data></Cell>
                        <Cell><Data ss:Type="String"><apex:outputText value="{!PLM.ItemDescription}" escape="true"/></Data></Cell>
                        <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.unitPrice}"/></Data></Cell>
                        <Cell><Data ss:Type="Number"><apex:outputText value="{!PLM.shellQuantity}"/></Data></Cell>
                        <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.shellTotal}"/></Data></Cell>
                    </Row>
                    <apex:variable value="{!shNum+1}" var="shNum"/>
                </apex:repeat>
            </Table>
        </Worksheet>

        <!-- 5. SPARE TAB -->
        <Worksheet ss:Name="SPARE">
            <Table>
                <Row><Cell ss:StyleID="BoldStyle"><Data ss:Type="String">Partlist Number :</Data></Cell>
                     <Cell><Data ss:Type="String"><apex:outputText value="{!PL.Name}"/></Data></Cell></Row>
                <Row><Cell/></Row>
                <Row>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Sr.No</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Item Code</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Item Description</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Unit Price</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">SPARE Qty</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">SPARE Total</Data></Cell>
                </Row>
                <apex:variable value="{!1}" var="spNum"/>
                <apex:repeat value="{!filterList}" var="PLM">
                    <Row>
                        <Cell><Data ss:Type="Number"><apex:outputText value="{!spNum}"/></Data></Cell>
                        <Cell><Data ss:Type="String"><apex:outputText value="{!PLM.L2ProductName}" escape="true"/></Data></Cell>
                        <Cell><Data ss:Type="String"><apex:outputText value="{!PLM.ItemDescription}" escape="true"/></Data></Cell>
                        <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.unitPrice}"/></Data></Cell>
                        <Cell><Data ss:Type="Number"><apex:outputText value="{!PLM.spareQuantity}"/></Data></Cell>
                        <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.spareTotal}"/></Data></Cell>
                    </Row>
                    <apex:variable value="{!spNum+1}" var="spNum"/>
                </apex:repeat>
            </Table>
        </Worksheet>

        <!-- 6. CUSTOM QUANTITY TAB (NEW) -->
        <Worksheet ss:Name="Custom">
            <Table>
                <Row><Cell ss:StyleID="BoldStyle"><Data ss:Type="String">Partlist Number :</Data></Cell>
                     <Cell><Data ss:Type="String"><apex:outputText value="{!PL.Name}"/></Data></Cell></Row>
                <Row><Cell/></Row>
                <Row>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Sr.No</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Item Code</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Item Description</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Unit Price</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Custom Qty</Data></Cell>
                    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Custom Total</Data></Cell>
                </Row>
                <apex:variable value="{!1}" var="custNum"/>
                <apex:repeat value="{!filterList}" var="PLM">
                    <apex:outputPanel rendered="{!PLM.customQuantity > 0}">
                        <Row>
                            <Cell><Data ss:Type="Number"><apex:outputText value="{!custNum}"/></Data></Cell>
                            <Cell><Data ss:Type="String"><apex:outputText value="{!PLM.L2ProductName}" escape="true"/></Data></Cell>
                            <Cell><Data ss:Type="String"><apex:outputText value="{!PLM.ItemDescription}" escape="true"/></Data></Cell>
                            <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.unitPrice}"/></Data></Cell>
                            <Cell><Data ss:Type="Number"><apex:outputText value="{!PLM.customQuantity}"/></Data></Cell>
                            <Cell ss:StyleID="CurrencyStyle"><Data ss:Type="Number"><apex:outputText value="{!PLM.customTotal}"/></Data></Cell>
                        </Row>
                        <apex:variable value="{!custNum+1}" var="custNum"/>
                    </apex:outputPanel>
                </apex:repeat>
            </Table>
        </Worksheet>

    </apex:outputPanel>

    <!-- Similar structure for PLS and PLT sections... -->

</Workbook>
</apex:page>