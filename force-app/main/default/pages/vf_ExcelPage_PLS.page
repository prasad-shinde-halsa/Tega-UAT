<apex:page standardController="Part_List__c" extensions="Ctrl_PartList_Metrix" contentType="application/x-excel#PLS_PartList_Data{!TODAY()}.xls">
    <table>
        <thead>
            <tr>
                <th></th>
                <th>Part List Number</th>
                <th>Customer Name</th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th>Type and Size</th>
            </tr>
        </thead>
        <tbody>
            <apex:repeat value="{!plList}" var="PLM2" id="plm2">
                <tr>
                    <td></td>
                    <td>{!PLM2.Name}</td>
                    <td>{!PLM2.Customer_Name__c}</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td>{!PLM2.Description__c}</td>
                </tr>
            </apex:repeat>
        </tbody>
    </table><br/><br/>
    <table>
        <thead>
            <tr>
                <th>Sr No.</th>
                <th>Item Code</th>
                <th>Item Description</th>
                <th>PNL</th>
                <th>SFB</th>
                <th>MFB</th>
                <th>SPARE</th>
                <th>TOTAL</th>
            </tr>
        </thead>
        <tbody>
            <apex:variable value="{!0}" var="proNum"/>
            <apex:repeat value="{!filterList2}" var="PLM" id="plm">
                <tr>
                    <td>
                        <apex:outputText value="{0}" style="float:right;">                
                            <apex:param value="{!proNum}"/> 
                            <apex:variable value="{!proNum+1}" var="proNum"/>
                        </apex:outputText>
                    </td>
                    <td><apex:outputText value="{!PLM.L2ProductName}" /></td>
                    <td><apex:outputText value="{!PLM.ItemDescription}" /></td>
                    <td><apex:outputText value="{!PLM.pnlQuantity}" style="float:right;" /></td>
                    <td><apex:outputText value="{!PLM.sfbQuantity}" style="float:right;" /></td>
                    <td><apex:outputText value="{!PLM.mfbQuantity}" style="float:right;" /></td>
                    <td><apex:outputText value="{!PLM.spareQuantity}" style="float:right;" /></td>
                    <td><apex:outputText value="{!PLM.PLStotalQuantity}" style="float:right;" /></td>
                </tr>
            </apex:repeat>
        </tbody>
    </table>
</apex:page>