<apex:page standardController="Quote"
           extensions="Ctrl_Quote_PartList_Detailed"
           renderAs="pdf"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           applyHtmlTag="false"
           applyBodyTag="false">

<html>
<head>
    <style>

        @page {
            size: A4 landscape;
            margin: 15mm 10mm 15mm 10mm;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 8px;
            color: #000000;
            margin: 0;
            padding: 0;
        }

        /* ── LOGO ─────────────────────────────────── */
        table.logoTable {
            width: 100%;
            border-collapse: collapse;
            border: none;
            margin-bottom: 12px;
        }
        table.logoTable td {
            border: none;
            padding: 0;
            vertical-align: top;
        }
        .logoCell     { width: 28%; }
        .logoCell img { width: 160px; height: auto; display: block; }
        .taglineCell  { width: 72%; padding-left: 12px; }
        .decorativeLine {
            height: 3px;
            background-color: #0066cc;
            margin-top: 6px;
            width: 55%;
        }

        /* ── HEADER INFO ──────────────────────────── */
        table.headerTable {
            width: 100%;
            border-collapse: collapse;
            border: none;
            margin-bottom: 10px;
        }
        table.headerTable td {
            border: none;
            padding: 1px 0;
            font-size: 8px;
            vertical-align: top;
        }
        .hLeft  { width: 50%; }
        .hRight { width: 50%; text-align: right; }
        .hLabel { font-weight: bold; display: inline-block; min-width: 110px; }
        .hValue { display: inline-block; }

        /* ── SECTION TITLE ────────────────────────── */
        .sectionTitle {
            font-weight: bold;
            text-decoration: underline;
            font-size: 9px;
            margin: 10px 0 6px 0;
        }

        /* ── DATA TABLE ───────────────────────────── */
        /*
           Flying Saucer rules applied:
           - colgroup col width  = only reliable column-width method
           - table-layout: fixed = required for colgroup to work
           - All td/th alignment = inline style only (CSS classes ignored on td)
           - No tfoot            = unreliable; totals go outside table as divs
           - rowspan in thead    = kept minimal; row1 Item/Qty/Price group labels
                                   row2 sub-labels only for Components cols
        */
        table.dataTable {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }
        table.dataTable th {
            border: 1px solid #000000;
            background-color: #ffffff;
            padding: 4px 4px;
            font-size: 8px;
            font-weight: bold;
            text-align: center;
            vertical-align: middle;
        }
        table.dataTable td {
            border: 1px solid #000000;
            padding: 3px 4px;
            font-size: 8px;
            vertical-align: middle;
            word-wrap: break-word;
            overflow: hidden;
        }

    </style>
</head>
<body>

<!-- ═══════════════════════════════════════════════════ -->
<!-- LOGO — standalone, completely outside data table   -->
<!-- ═══════════════════════════════════════════════════ -->
<table class="logoTable">
    <tr>
        <td class="logoCell">
            <img src="{!URLFOR($Resource.TegaLogo)}" alt="Tega Logo"/>
        </td>
        <td class="taglineCell">
            <div style="font-size:16px;color:#666666;letter-spacing:2px;font-weight:normal;margin:0;padding-top:8px;"></div>
            <div class="decorativeLine"></div>
        </td>
    </tr>
</table>

<!-- ═══════════════════════════════════════════════════ -->
<!-- HEADER INFO                                        -->
<!-- ═══════════════════════════════════════════════════ -->
<table class="headerTable">
    <tr>
        <td class="hLeft">
            <div><span class="hLabel">Customer :</span><span class="hValue">{!PL.Customer_Name__c}</span></div>
            <div><span class="hLabel">Branch :</span><span class="hValue">{!QuoteRecord.Branch__r.Name}</span></div>
            <div><span class="hLabel">Part List &amp; Rev No :</span><span class="hValue">{!PL.Name} {!Quote.Part_List__r.Version_Number_Component__c}</span></div>
            
            <div><span class="hLabel">Enquiry No. :</span><span class="hValue">{!QuoteRecord.Enquiry_Number__c}</span></div>
            <div><span class="hLabel">Description :</span><span class="hValue">{!PL.Description__c}</span></div>
            <div><span class="hLabel">Destination :</span><span class="hValue">{!Quote.Port__c}</span></div>
        </td>
        <td class="hRight">
            <div>
                <span class="hLabel">Issued :</span>
                <span class="hValue">
                    <apex:outputText value="{0,date,MMM dd, yyyy}"><apex:param value="{!TODAY()}"/></apex:outputText>
                </span>
            </div>
            <div><span class="hLabel">SAP Offer No.:</span><span class="hValue">{!Quote.SAP_Offer_Id__c}</span></div>
            
            <div><span class="hLabel">Quote No. :</span><span class="hValue">{!QuoteRecord.QuoteNumber}</span></div>
            <div>
                <span class="hLabel">Validity :</span>
                <span class="hValue">
                    <apex:outputText value="{0,date,MMM dd, yyyy}"><apex:param value="{!QuoteRecord.Quotation_Validity__c}"/></apex:outputText>
                </span>
            </div>
            <div><span class="hLabel">Currency :</span><span class="hValue">{!QuoteRecord.CurrencyIsoCode}</span></div>
            <div><span class="hLabel">Delivery Schedule (In weeks) :</span><span class="hValue">{!QuoteRecord.Delivery_Schedule__c}</span></div>
        </td>
    </tr>
</table>

<!-- ═══════════════════════════════════════════════════ -->
<!-- SECTION TITLE                                      -->
<!-- ═══════════════════════════════════════════════════ -->
<div class="sectionTitle">Product Description:</div>

<!-- ═══════════════════════════════════════════════════════════════
     DATA TABLE — 6 columns (Customer Part Code removed)
     Col1 Item No   :  30px
     Col2 Qty       :  45px
     Col3 Part Desc : 260px   (widest — item description text)
     Col4 Tega P/N  : 160px
     Col5 Each      :  90px
     Col6 Total     :  90px
     Total          : 675px  (fits A4 landscape ~730px usable)

     HEADER:
       Row 1: Item No | Qty | "Components Components" (colspan=2) | "Price (AUD)" (colspan=2)
       Row 2: blank   | blank | Part Number (Description) | Tega Part Number | Each | Total
     ═══════════════════════════════════════════════════════════════ -->
<table class="dataTable">

    <!-- colgroup — only reliable width mechanism in Flying Saucer -->
    <colgroup>
        <col style="width:30px;"/>   <!-- Col1: Item No        -->
        <col style="width:45px;"/>   <!-- Col2: Qty            -->
        <col style="width:260px;"/>  <!-- Col3: Part Desc      -->
        <col style="width:160px;"/>  <!-- Col4: Tega Part No   -->
        <col style="width:90px;"/>   <!-- Col5: Each           -->
        <col style="width:90px;"/>   <!-- Col6: Total          -->
    </colgroup>

    <thead>
        <!-- Header Row 1: group labels -->
        <tr>
            <th style="text-align:center;vertical-align:middle;">Item<br/>No.</th>
            <th style="text-align:center;vertical-align:middle;">Qty</th>
            <th colspan="2" style="text-align:center;vertical-align:middle;">Components Components</th>
            <th colspan="2" style="text-align:center;vertical-align:middle;">Price ({!QuoteRecord.CurrencyIsoCode})</th>
        </tr>
        <!-- Header Row 2: sub-column labels -->
        <tr>
            <th style="text-align:center;">&#160;</th>
            <th style="text-align:center;">&#160;</th>
            <th style="text-align:center;">Part Number (Description)</th>
            <th style="text-align:center;">Tega Part Number</th>
            <th style="text-align:center;">Each</th>
            <th style="text-align:center;">Total</th>
        </tr>
    </thead>

    <tbody>
        <apex:repeat value="{!detailedRows}" var="row">

            <!-- Full-Set rows (FEH/DEH/SHELL/SPARE) — Item No cell blank -->
            <apex:outputPanel rendered="{!row.isFullSetRow}" layout="none">
                <tr>
                    <td style="text-align:center;">&#160;</td>
                    <td style="text-align:center;">1</td>
                    <td style="text-align:left;word-wrap:break-word;">{!row.itemDescription}</td>
                    <td style="text-align:left;word-wrap:break-word;">{!row.tegaPartNumber}</td>
                    <td style="text-align:right;">
                        <apex:outputText value="{0, number, ###,##0.00}">
                            <apex:param value="{!row.lineTotal}"/>
                        </apex:outputText>
                    </td>
                    <td style="text-align:right;">
                        <apex:outputText value="{0, number, ###,##0.00}">
                            <apex:param value="{!row.lineTotal}"/>
                        </apex:outputText>
                    </td>
                </tr>
            </apex:outputPanel>

            <!-- Custom rows — numbered Item No -->
            <apex:outputPanel rendered="{!NOT(row.isFullSetRow)}" layout="none">
                <tr>
                    <td style="text-align:center;">{!row.itemNo}</td>
                    <td style="text-align:center;">
                        <apex:outputText value="{0, number, ##0.##}">
                            <apex:param value="{!row.qty}"/>
                        </apex:outputText>
                    </td>
                    <td style="text-align:left;word-wrap:break-word;">{!row.itemDescription}</td>
                    <td style="text-align:left;word-wrap:break-word;">{!row.tegaPartNumber}</td>
                    <td style="text-align:right;">
                        <apex:outputText value="{0, number, ###,##0.00}">
                            <apex:param value="{!row.unitPrice}"/>
                        </apex:outputText>
                    </td>
                    <td style="text-align:right;">
                        <apex:outputText value="{0, number, ###,##0.00}">
                            <apex:param value="{!row.lineTotal}"/>
                        </apex:outputText>
                    </td>
                </tr>
            </apex:outputPanel>

        </apex:repeat>
    </tbody>

</table>

<!-- ═══════════════════════════════════════════════════ -->
<!-- TOTALS — outside table, right-aligned below        -->
<!-- ═══════════════════════════════════════════════════ -->
<div style="width:100%;text-align:right;margin-top:8px;">
    <div style="font-weight:bold;font-size:8px;margin-bottom:3px;">
        <span style="display:inline-block;text-align:right;padding-right:4px;">
            Total Value of Quotation
        </span>
        <span style="display:inline-block;min-width:160px;text-align:left;border:1px solid #000;padding:3px 6px;">
            {!QuoteRecord.CurrencyIsoCode}&#160;<apex:outputText value="{0, number, ###,##0.00}"><apex:param value="{!FLOOR(overallGrandTotal)}"/></apex:outputText>
        </span>
    </div>
    <div style="font-weight:bold;font-size:8px;margin-top:3px;">
        <span style="display:inline-block;padding-right:4px;">Amount In Words:</span>
        <span style="display:inline-block;">{!QuoteRecord.CurrencyIsoCode}&#160;{!OverallAmountInWords}</span>
    </div>
</div>

</body>
</html>

</apex:page>