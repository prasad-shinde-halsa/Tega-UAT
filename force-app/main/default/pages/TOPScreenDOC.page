<apex:page standardController="Quote"
           extensions="Ctrl_Quote_PartList_Metrix"
           contentType="application/msword#Quote_PartList.doc"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           applyHtmlTag="false"
           applyBodyTag="false">

<html xmlns:o="urn:schemas-microsoft-com:office:office" 
      xmlns:w="urn:schemas-microsoft-com:office:word">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <style>
        /* Note: MS Word does not fully support CSS3 @page rules like PDF engines do. 
           Basic margins and page breaks will work, but running headers/footers (@top-left, etc.) 
           may render differently or appear inline rather than in the actual Word header/footer area. */
        @page {
            size: A4 portrait;
            margin-left: 15px;
            margin-right: 15px;
            margin-top: 50px;
            margin-bottom: 50px;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 9px;
            color: #000000;
        }

        #pageHeader {
            width: 565px;
            background: #ffffff;
            padding-bottom: 4px;
            margin-bottom: 20px;
        }

        .logoTable {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 4px;
        }

        .logoCell {
            width: 25%;
            vertical-align: middle;
            border: none;
            padding: 0;
        }

        .logoCell img {
            width: 100px;
            height: auto;
            display: block;
        }

        .taglineCell {
            width: 75%;
            vertical-align: middle;
            border: none;
            padding-left: 8px;
        }

        .decorativeLine {
            height: 2px;
            width: 100%;
            background: #0066cc; /* Linear gradients may not render well in older Word versions, defaulting to solid */
            margin-bottom: 6px;
        }

        .headerInfoTable {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .headerInfoTable td {
            border: none;
            padding: 1px 2px;
            vertical-align: top;
            font-size: 8.5px;
        }

        .hLeft {
            width: 55%;
            vertical-align: top;
        }

        .hRight {
            width: 45%;
            vertical-align: top;
            text-align: right;
            padding-right: 0;
        }

        .hRight .hRow {
            text-align: right;
        }

        .hRow {
            margin-bottom: 2px;
            line-height: 1.35;
        }

        .hLabel {
            font-weight: bold;
        }

        .headerDivider {
            width: 100%;
            height: 1px;
            background-color: #0066cc;
            margin-top: 5px;
        }

        .sectionTitle {
            font-weight: bold;
            text-decoration: underline;
            font-size: 10px;
            margin-top: 12px;
            margin-bottom: 8px;
        }

        .fullSetTable {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
        }

        .fullSetTable th {
            border: 1px solid #000;
            background-color: #f2f2f2;
            padding: 4px 3px;
            text-align: center;
            font-weight: bold;
            font-size: 7.5px;
        }

        .fullSetTable td {
            border: 1px solid #000;
            padding: 3px 3px;
            vertical-align: middle;
            font-size: 7.5px;
        }

        .fsItemNoCol   { width: 4%; }
        .fsQtySmCol    { width: 5%; }
        .fsTotalQtyCol { width: 5%; }
        .fsDescCol     { width: 33%; }
        .fsTegaCol     { width: 22%; }
        .fsPriceCol    { width: 10%; }

        .mainTable {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
        }

        .mainTable th {
            border: 1px solid #000;
            background-color: #f2f2f2;
            padding: 5px 3px;
            text-align: center;
            font-weight: bold;
            font-size: 8px;
        }

        .mainTable td {
            border: 1px solid #000;
            padding: 4px 3px;
            vertical-align: middle;
            font-size: 8px;
        }

        .textCenter { text-align: center; }
        .textRight  { text-align: right; }
        .textLeft   { text-align: left; }

        .wrapText {
            word-wrap: break-word;
            white-space: normal;
        }

        .itemNoCol     { width: 5%; }
        .qtyCol        { width: 5%; }
        .partNumberCol { width: 35%; }
        .tegaPartCol   { width: 25%; }
        .priceEachCol  { width: 13%; }
        .priceTotalCol { width: 13%; }

        .totalSection {
            width: 100%;
            margin-top: 12px;
            text-align: right;
        }

        .grandTotalRow {
            font-weight: bold;
            font-size: 9px;
            margin-bottom: 4px;
        }

        .totalLabel {
            display: inline-block;
            min-width: 200px;
            text-align: right;
            padding-right: 10px;
        }

        .totalValue {
            display: inline-block;
            min-width: 130px;
            text-align: right;
            border: 1px solid #000;
            padding: 3px 6px;
        }

        .amountInWords {
            font-weight: bold;
            font-size: 8px;
            margin-top: 4px;
        }

        /* Standard page break for MS Word HTML rendering */
        br.pageBreak {
            page-break-before: always;
            mso-break-type: section-break;
        }

    </style>

</head>

<body>

    <div id="pageHeader">

        <table class="logoTable">
            <tr>
                <td class="logoCell">
                    <img src="{!URLFOR($Resource.TegaLogo)}" alt="Tega Logo"/>
                </td>
                <td class="taglineCell">
                    </td>
            </tr>
        </table>

        <div class="decorativeLine"></div>

        <table class="headerInfoTable">
            <tr>
                <td class="hLeft">
                    <div class="hRow">
                        <span class="hLabel">Customer : </span>{!PL.Customer_Name__c}
                    </div>
                    <div class="hRow">
                        <span class="hLabel">Branch : </span>{!Quote.Branch__r.Name}
                    </div>
                    <div class="hRow">
                        <span class="hLabel">Part List &amp; Rev No : </span>{!PL.Name}&#160;{!Quote.Part_List__r.Version_Number_Component__c}
                    </div>
                    <div class="hRow">
                        <span class="hLabel">Enquiry No. : </span>{!Quote.Enquiry_Number__c}
                    </div>
                    <div class="hRow">
                        <span class="hLabel">Description : </span>{!PL.Description__c}
                    </div>
                    <div class="hRow">
                        <span class="hLabel">Destination : </span>{!Quote.Port__c}
                    </div>
                </td>

                <td class="hRight">
                    <table style="width:100%; border-collapse:collapse;">
                        <tr>
                            <td style="text-align:right; padding:0; border:none; font-size:8.5px;">
                                <div class="hRow">
                                    <span class="hLabel">Issued : </span>
                                    <apex:outputText value="{0,date,MMM dd, yyyy}">
                                        <apex:param value="{!TODAY()}"/>
                                    </apex:outputText>
                                </div>
                                <div class="hRow">
                                    <span class="hLabel">SAP Offer Number : </span>{!Quote.SAP_Offer_Id__c}
                                </div>
                                <div class="hRow">
                                    <span class="hLabel">Quote No. : </span>{!Quote.QuoteNumber}
                                </div>
                                <div class="hRow">
                                    <span class="hLabel">Validity : </span>
                                    <apex:outputText value="{0,date,MMM dd, yyyy}">
                                        <apex:param value="{!Quote.Quotation_Validity__c}"/>
                                    </apex:outputText>
                                </div>
                                <div class="hRow">
                                    <span class="hLabel">Currency : </span>{!Quote.CurrencyIsoCode}
                                </div>
                                <div class="hRow">
                                    <span class="hLabel">Delivery Schedule (In Weeks) : </span>{!Quote.Delivery_Schedule__c}
                                </div>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <div class="headerDivider"></div>

    </div>
    <apex:outputPanel layout="block" rendered="{!showFullSet}">
        <div class="sectionTitle">Product Description:</div>
        <table class="fullSetTable">
            <thead>
                <tr>
                    <th rowspan="2" class="fsItemNoCol">Item<br/>No.</th>
                    <th colspan="4">Quantity Required</th>
                    <th rowspan="2" class="fsTotalQtyCol">Total</th>
                    <th rowspan="2" class="fsDescCol">Description</th>
                    <th rowspan="2" class="fsTegaCol">Tega Part Number</th>
                    <th colspan="2">Price ({!Quote.CurrencyIsoCode})</th>
                </tr>
                <tr>
                    <th class="fsQtySmCol">FEH</th>
                    <th class="fsQtySmCol">Shell</th>
                    <th class="fsQtySmCol">DEH</th>
                    <th class="fsQtySmCol">Spare</th>
                    <th class="fsPriceCol">Each</th>
                    <th class="fsPriceCol">Total</th>
                </tr>
            </thead>
            <tbody>
                <apex:variable value="{!1}" var="rowNum"/>
                <apex:repeat value="{!filterList}" var="PLM">
                    <tr>
                        <td class="textCenter">{!rowNum}</td>
                        <td class="textCenter">{!PLM.fehQuantity}</td>
                        <td class="textCenter">{!PLM.shellQuantity}</td>
                        <td class="textCenter">{!PLM.dehQuantity}</td>
                        <td class="textCenter">{!PLM.spareQuantity}</td>
                        <td class="textCenter">{!PLM.PLMtotalQuantity}</td>
                        <td class="textLeft wrapText">{!PLM.ItemDescription}</td>
                        <td class="textLeft wrapText">{!PLM.L2ProductName}</td>
                        <td class="textRight">
                            <apex:outputText value="{0, number, ###,##0.00}">
                                <apex:param value="{!PLM.unitPrice}"/>
                            </apex:outputText>
                        </td>
                        <td class="textRight">
                            <apex:outputText value="{0, number, ###,##0.00}">
                                <apex:param value="{!PLM.PLMtotalValue}"/>
                            </apex:outputText>
                        </td>
                    </tr>
                    <apex:variable value="{!rowNum+1}" var="rowNum"/>
                </apex:repeat>
            </tbody>
        </table>
        <div class="totalSection">
            <div class="grandTotalRow">
                <span class="totalLabel">Total Value of Quotation</span>
                <span class="totalValue">
                    {!Quote.CurrencyIsoCode}&#160;
                    <apex:outputText value="{0, number, ###,##0.00}">
                        <apex:param value="{!FLOOR(fullSetGrandTotal)}"/>
                    </apex:outputText>
                </span>
            </div>
            <div class="amountInWords">
                <span class="totalLabel">Amount In Words: AUD {!FullSetAmountInWords}</span>
            </div>
        </div>
    </apex:outputPanel>


    <apex:outputPanel layout="block" rendered="{!showFEH}">
        <br class="pageBreak" style="page-break-before: always; clear: both;" />
        <div class="sectionTitle">Product Description: FEH</div>
        <table class="mainTable">
            <thead>
                <tr>
                    <th rowspan="2" class="itemNoCol">Item<br/>No.</th>
                    <th rowspan="2" class="qtyCol">Qty</th>
                    <th colspan="2">Feed End Components - FEH</th>
                    <th colspan="2">Price ({!Quote.CurrencyIsoCode})</th>
                </tr>
                <tr>
                    <th class="partNumberCol">Part Number (Description)</th>
                    <th class="tegaPartCol">Tega Part Number</th>
                    <th class="priceEachCol">Each</th>
                    <th class="priceTotalCol">Total</th>
                </tr>
            </thead>
            <tbody>
                <apex:variable value="{!1}" var="fehNum"/>
                <apex:repeat value="{!filterList}" var="PLM">
                    <tr>
                        <td class="textCenter">{!fehNum}</td>
                        <td class="textCenter">{!PLM.fehQuantity}</td>
                        <td class="textLeft wrapText">{!PLM.ItemDescription}</td>
                        <td class="textLeft wrapText">{!PLM.L2ProductName}</td>
                        <td class="textRight">
                            <apex:outputText value="{0, number, ###,##0.00}">
                                <apex:param value="{!PLM.unitPrice}"/>
                            </apex:outputText>
                        </td>
                        <td class="textRight">
                            <apex:outputText value="{0, number, ###,##0.00}">
                                <apex:param value="{!PLM.fehTotal}"/>
                            </apex:outputText>
                        </td>
                    </tr>
                    <apex:variable value="{!fehNum+1}" var="fehNum"/>
                </apex:repeat>
            </tbody>
        </table>
        <div class="totalSection">
            <div class="grandTotalRow">
                <span class="totalLabel">Total Value of Quotation</span>
                <span class="totalValue">
                    {!Quote.CurrencyIsoCode}&#160;
                    <apex:outputText value="{0, number, ###,##0.00}">
                        <apex:param value="{!FLOOR(fehGrandTotal)}"/>
                    </apex:outputText>
                </span>
            </div>
            <div class="amountInWords">
                <span class="totalLabel">Amount In Words: AUD {!FEHAmountInWords}</span>
            </div>
        </div>
    </apex:outputPanel>


    <apex:outputPanel layout="block" rendered="{!showDEH}">
        <br class="pageBreak" style="page-break-before: always; clear: both;" />
        <div class="sectionTitle">Product Description: DEH</div>
        <table class="mainTable">
            <thead>
                <tr>
                    <th rowspan="2" class="itemNoCol">Item<br/>No.</th>
                    <th rowspan="2" class="qtyCol">Qty</th>
                    <th colspan="2">Discharge End Components - DEH</th>
                    <th colspan="2">Price ({!Quote.CurrencyIsoCode})</th>
                </tr>
                <tr>
                    <th class="partNumberCol">Part Number (Description)</th>
                    <th class="tegaPartCol">Tega Part Number</th>
                    <th class="priceEachCol">Each</th>
                    <th class="priceTotalCol">Total</th>
                </tr>
            </thead>
            <tbody>
                <apex:variable value="{!1}" var="dehNum"/>
                <apex:repeat value="{!filterList}" var="PLM">
                    <tr>
                        <td class="textCenter">{!dehNum}</td>
                        <td class="textCenter">{!PLM.dehQuantity}</td>
                        <td class="textLeft wrapText">{!PLM.ItemDescription}</td>
                        <td class="textLeft wrapText">{!PLM.L2ProductName}</td>
                        <td class="textRight">
                            <apex:outputText value="{0, number, ###,##0.00}">
                                <apex:param value="{!PLM.unitPrice}"/>
                            </apex:outputText>
                        </td>
                        <td class="textRight">
                            <apex:outputText value="{0, number, ###,##0.00}">
                                <apex:param value="{!PLM.dehTotal}"/>
                            </apex:outputText>
                        </td>
                    </tr>
                    <apex:variable value="{!dehNum+1}" var="dehNum"/>
                </apex:repeat>
            </tbody>
        </table>
        <div class="totalSection">
            <div class="grandTotalRow">
                <span class="totalLabel">Total Value of Quotation</span>
                <span class="totalValue">
                    {!Quote.CurrencyIsoCode}&#160;
                    <apex:outputText value="{0, number, ###,##0.00}">
                        <apex:param value="{!FLOOR(dehGrandTotal)}"/>
                    </apex:outputText>
                </span>
            </div>
            <div class="amountInWords">
                <span class="totalLabel">Amount In Words: AUD {!DEHAmountInWords}</span>
            </div>
        </div>
    </apex:outputPanel>


    <apex:outputPanel layout="block" rendered="{!showSHELL}">
        <br class="pageBreak" style="page-break-before: always; clear: both;" />
        <div class="sectionTitle">Product Description: SHELL</div>
        <table class="mainTable">
            <thead>
                <tr>
                    <th rowspan="2" class="itemNoCol">Item<br/>No.</th>
                    <th rowspan="2" class="qtyCol">Qty</th>
                    <th colspan="2">Shell Components - SHELL</th>
                    <th colspan="2">Price ({!Quote.CurrencyIsoCode})</th>
                </tr>
                <tr>
                    <th class="partNumberCol">Part Number (Description)</th>
                    <th class="tegaPartCol">Tega Part Number</th>
                    <th class="priceEachCol">Each</th>
                    <th class="priceTotalCol">Total</th>
                </tr>
            </thead>
            <tbody>
                <apex:variable value="{!1}" var="shNum"/>
                <apex:repeat value="{!filterList}" var="PLM">
                    <tr>
                        <td class="textCenter">{!shNum}</td>
                        <td class="textCenter">{!PLM.shellQuantity}</td>
                        <td class="textLeft wrapText">{!PLM.ItemDescription}</td>
                        <td class="textLeft wrapText">{!PLM.L2ProductName}</td>
                        <td class="textRight">
                            <apex:outputText value="{0, number, ###,##0.00}">
                                <apex:param value="{!PLM.unitPrice}"/>
                            </apex:outputText>
                        </td>
                        <td class="textRight">
                            <apex:outputText value="{0, number, ###,##0.00}">
                                <apex:param value="{!PLM.shellTotal}"/>
                            </apex:outputText>
                        </td>
                    </tr>
                    <apex:variable value="{!shNum+1}" var="shNum"/>
                </apex:repeat>
            </tbody>
        </table>
        <div class="totalSection">
            <div class="grandTotalRow">
                <span class="totalLabel">Total Value of Quotation</span>
                <span class="totalValue">
                    {!Quote.CurrencyIsoCode}&#160;
                    <apex:outputText value="{0, number, ###,##0.00}">
                        <apex:param value="{!FLOOR(shellGrandTotal)}"/>
                    </apex:outputText>
                </span>
            </div>
            <div class="amountInWords">
                <span class="totalLabel">Amount In Words: AUD {!ShellAmountInWords}</span>
            </div>
        </div>
    </apex:outputPanel>


    <apex:outputPanel layout="block" rendered="{!showSPARE}">
        <br class="pageBreak" style="page-break-before: always; clear: both;" />
        <div class="sectionTitle">Product Description: SPARE</div>
        <table class="mainTable">
            <thead>
                <tr>
                    <th rowspan="2" class="itemNoCol">Item<br/>No.</th>
                    <th rowspan="2" class="qtyCol">Qty</th>
                    <th colspan="2">Spare Components - SPARE</th>
                    <th colspan="2">Price ({!Quote.CurrencyIsoCode})</th>
                </tr>
                <tr>
                    <th class="partNumberCol">Part Number (Description)</th>
                    <th class="tegaPartCol">Tega Part Number</th>
                    <th class="priceEachCol">Each</th>
                    <th class="priceTotalCol">Total</th>
                </tr>
            </thead>
            <tbody>
                <apex:variable value="{!1}" var="spNum"/>
                <apex:repeat value="{!filterList}" var="PLM">
                    <tr>
                        <td class="textCenter">{!spNum}</td>
                        <td class="textCenter">{!PLM.spareQuantity}</td>
                        <td class="textLeft wrapText">{!PLM.ItemDescription}</td>
                        <td class="textLeft wrapText">{!PLM.L2ProductName}</td>
                        <td class="textRight">
                            <apex:outputText value="{0, number, ###,##0.00}">
                                <apex:param value="{!PLM.unitPrice}"/>
                            </apex:outputText>
                        </td>
                        <td class="textRight">
                            <apex:outputText value="{0, number, ###,##0.00}">
                                <apex:param value="{!PLM.spareTotal}"/>
                            </apex:outputText>
                        </td>
                    </tr>
                    <apex:variable value="{!spNum+1}" var="spNum"/>
                </apex:repeat>
            </tbody>
        </table>
        <div class="totalSection">
            <div class="grandTotalRow">
                <span class="totalLabel">Total Value of Quotation</span>
                <span class="totalValue">
                    {!Quote.CurrencyIsoCode}&#160;
                    <apex:outputText value="{0, number, ###,##0.00}">
                        <apex:param value="{!FLOOR(spareGrandTotal)}"/>
                    </apex:outputText>
                </span>
            </div>
            <div class="amountInWords">
                <span class="totalLabel">Amount In Words: AUD {!SpareAmountInWords}</span>
            </div>
        </div>
    </apex:outputPanel>


    <apex:variable value="{!0}" var="customCount"/>
    <apex:repeat value="{!filterList}" var="PLM">
        <apex:outputPanel rendered="{!PLM.customQuantity > 0}">
            <apex:variable value="{!customCount+1}" var="customCount"/>
        </apex:outputPanel>
    </apex:repeat>

    <apex:outputPanel layout="block" rendered="{!customCount > 0}">
        <br class="pageBreak" style="page-break-before: always; clear: both;" />
        <div class="sectionTitle">Product Description: CUSTOM</div>
        <table class="mainTable">
            <thead>
                <tr>
                    <th rowspan="2" class="itemNoCol">Item<br/>No.</th>
                    <th rowspan="2" class="qtyCol">Qty</th>
                    <th colspan="2">Custom Components - CUSTOM</th>
                    <th colspan="2">Price ({!Quote.CurrencyIsoCode})</th>
                </tr>
                <tr>
                    <th class="partNumberCol">Part Number (Description)</th>
                    <th class="tegaPartCol">Tega Part Number</th>
                    <th class="priceEachCol">Each</th>
                    <th class="priceTotalCol">Total</th>
                </tr>
            </thead>
            <tbody>
                <apex:variable value="{!1}" var="custNum"/>
                <apex:repeat value="{!filterList}" var="PLM">
                    <apex:outputPanel layout="none" rendered="{!PLM.customQuantity > 0}">
                        <tr>
                            <td class="textCenter">{!custNum}</td>
                            <td class="textCenter">{!FLOOR(PLM.customQuantity)}</td>
                            <td class="textLeft wrapText">{!PLM.ItemDescription}</td>
                            <td class="textLeft wrapText">{!PLM.L2ProductName}</td>
                            <td class="textRight">
                                <apex:outputText value="{0, number, ###,##0.00}">
                                    <apex:param value="{!PLM.unitPrice}"/>
                                </apex:outputText>
                            </td>
                            <td class="textRight">
                                <apex:outputText value="{0, number, ###,##0.00}">
                                    <apex:param value="{!PLM.customTotal}"/>
                                </apex:outputText>
                            </td>
                        </tr>
                        <apex:variable value="{!custNum+1}" var="custNum"/>
                    </apex:outputPanel>
                </apex:repeat>
            </tbody>
        </table>
        <div class="totalSection">
            <div class="grandTotalRow">
                <span class="totalLabel">Total Value of Quotation</span>
                <span class="totalValue">
                    {!Quote.CurrencyIsoCode}&#160;
                    <apex:outputText value="{0, number, ###,##0.00}">
                        <apex:param value="{!FLOOR(customGrandTotal)}"/>
                    </apex:outputText>
                </span>
            </div>
            <div class="amountInWords">
                <span class="totalLabel">Amount In Words: AUD {!CustomAmountInWords}</span>
            </div>
        </div>
    </apex:outputPanel>

</body>

</html>
</apex:page>